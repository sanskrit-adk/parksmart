# Copy to .env.local (local dev) and add the same keys in Vercel → Settings → Environment Variables.

# --- App -------------------------------------------------------------------
# Public URL of the site (used for metadata and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser. Used by API routes and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Project Settings -> Database -> Connection string -> URI (session pooler).
# Used by `npm run db:migrate` and `npm run check:env`.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- Mapbox (account.mapbox.com → Tokens) ------------------------------------
# A public "pk." token. Restrict it to your domains in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- OpenAI (platform.openai.com/api-keys) -----------------------------------
# Server only. Powers AI search, the assistant, pricing, insights, plate reading and vision detection.
# Without it, the app falls back to rule-based search and pricing, and clearly labels that.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Model used for images (plates, lot photos). Must support vision.
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- Stripe (dashboard.stripe.com/test/apikeys), TEST MODE --------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the webhook endpoint you create in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Computer vision service (optional) --------------------------------------
# URL of the YOLOv8 FastAPI service in services/cv. Without it, lot photos are analysed by the vision model.
CV_SERVICE_URL=
# Shared secret; set the same value as CV_SERVICE_TOKEN on the service.
CV_SERVICE_TOKEN=

# --- Cron (optional) --------------------------------------------------------
# Only needed if you use Vercel Cron instead of pg_cron to call /api/cron/tick.
CRON_SECRET=

# --- Seed script (optional) --------------------------------------------------
# Password for the driver/host/admin test accounts.
SEED_TEST_PASSWORD=ParkSmart-Demo-2026!
